# Copy to .env and edit. Every value has a working default in docker-compose.yml,
# so the stack boots without this file; it exists for real deployments.
#
# DEMO VALUES ONLY. The passwords and the SECRET_KEY below are placeholders for
# a local demo stack. Replace every one of them before the stack is reachable
# by anyone else.

# Django
DEBUG=0
SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1] web
LOG_LEVEL=INFO

# Database (PostgreSQL). Set DB_ENGINE=django.db.backends.sqlite3 for a local file DB.
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=library_db
POSTGRES_USER=library_user
# Demo password.
POSTGRES_PASSWORD=library_password
DB_HOST=db
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Notifications
NOTIFICATION_CHANNELS=library.notifications.email.EmailChannel
OVERDUE_NOTIFICATION_BATCH_SIZE=500
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=admin@library.com

# Demo seed accounts (seed_library). Change before exposing the stack.
LIBRARIAN_USERNAME=librarian
LIBRARIAN_PASSWORD=librarian
SEED_MEMBER_PASSWORD=library-demo

# CORS
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=
